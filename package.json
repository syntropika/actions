{
  "name": "@syntropika/actions",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./coolify-deploy/src/main.ts --target=node --outfile ./coolify-deploy/dist/main.js",
    "test": "bun test",
